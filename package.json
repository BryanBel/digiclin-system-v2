{
  "name": "digiclin",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @digiclin/shared build && pnpm --parallel --filter \"./apps/*\" --filter @digiclin/shared dev",
    "build": "pnpm --filter @digiclin/shared build && pnpm --filter @digiclin/api build && pnpm --filter @digiclin/web build",
    "start": "pnpm --filter @digiclin/api start:prod",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "openapi": "pnpm --filter @digiclin/api openapi:export && pnpm --filter @digiclin/web openapi:types"
  },
  "devDependencies": {
    "oxlint": "^1.58.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1"
  }
}
