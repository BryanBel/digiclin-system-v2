# Copia este archivo a .env y completa los valores.
#
# .env esta en .gitignore y no debe versionarse nunca: una version anterior de este
# repositorio lo tenia commiteado con credenciales reales.

# Cadena de conexion de PostgreSQL. Cualquier proveedor sirve: el backend usa pg, no un SDK.
DATABASE_URL=

# Idem para NODE_ENV=dev.
SUPABASE_DB_URL_DEV=

# Alternativa historica a DATABASE_URL, leida primero con NODE_ENV=prod.
SUPABASE_DB_URL_PROD=

# Firma la cookie de sesion. Genera 48 bytes aleatorios; no reutilices el de abajo.
ACCESS_TOKEN_SECRET=

# Firma los enlaces de verificacion. Debe ser distinto del anterior.
EMAIL_VERIFICATION_SECRET=

# Lista blanca de origenes separada por comas.
CORS_ORIGIN=

BACKEND_URL=

FRONTEND_URL=

FRONTEND_BASE_URL=

PUBLIC_FRONTEND_URL=

PUBLIC_BACKEND_URL=

RESEND_API_KEY=

RESEND_FROM_EMAIL=

RESEND_TEST_RECIPIENT=

EMAIL_USER=

EMAIL_PASS=

# Contrasena de las cuentas que crea src/db/seed.js. Minimo 12 caracteres.
SEED_PASSWORD=
