# Copia este archivo a .env y completa los valores.
#
# .env esta en .gitignore y no debe versionarse nunca: una version anterior de este
# repositorio lo tenia commiteado con credenciales reales.

# Cadena de conexion de PostgreSQL. Cualquier proveedor sirve: el backend usa pg, no un
# SDK. Usa la conexion directa, no la pooled: este servidor es un proceso persistente y
# pg.Pool ya agrupa conexiones por su cuenta.
DATABASE_URL=

# Firma la cookie de sesion. Genera 48 bytes aleatorios; no reutilices el de abajo.
ACCESS_TOKEN_SECRET=

# Firma los enlaces de verificacion. Debe ser distinto del anterior.
EMAIL_VERIFICATION_SECRET=

# Lista blanca de origenes separada por comas.
CORS_ORIGIN=

BACKEND_URL=

FRONTEND_URL=

FRONTEND_BASE_URL=

PUBLIC_FRONTEND_URL=

PUBLIC_BACKEND_URL=

RESEND_API_KEY=

RESEND_FROM_EMAIL=


EMAIL_USER=

EMAIL_PASS=

# Contrasena de las cuentas que crea src/db/seed.js. Minimo 12 caracteres.
# Solo desarrollo. Redirige TODO el correo saliente a esta direccion, util porque el plan
# gratuito de Resend solo entrega a la direccion verificada de la cuenta. Se ignora cuando
# NODE_ENV=prod. Dejala vacia salvo que la necesites.
EMAIL_REDIRECT_TO=

SEED_PASSWORD=
