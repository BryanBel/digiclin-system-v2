# Copia este archivo a .env y completa los valores. .env nunca se versiona.

# development | test | production
NODE_ENV=development

PORT=3000

# Cadena de conexion DIRECTA de Neon (sin "-pooler"): la API es un proceso persistente y
# pg.Pool ya agrupa conexiones. En local usa SIEMPRE la rama "dev" de Neon, nunca produccion.
# Usa sslmode=verify-full (no "require"): pg v9 rebajara "require" a no verificar el certificado.
DATABASE_URL=

# true solo en produccion: la API sirve tambien la web compilada de apps/web (mismo origen).
SERVE_WEB=false

# Cabecera con la IP real del cliente que agrega el proxy del hosting (p. ej. en Render).
# Sin ella, los limites de intentos de ingreso no distinguen clientes. En local, vacia.
# Pendiente: verificar cual usa Render antes del lanzamiento (fase 7).
CLIENT_IP_HEADER=

# true = duenos, socios y medicos no operan sin verificacion en dos pasos.
REQUIRE_STAFF_2FA=false

# Origen que ve el usuario; base de los enlaces de los correos.
PUBLIC_URL=http://localhost:4321

# Firma sesiones y tokens. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=

# console (desarrollo: el correo sale en la consola de la API) | brevo
MAIL_PROVIDER=console
# Solo con brevo: clave de la API y remitente verificado en Brevo.
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=DigiClin
