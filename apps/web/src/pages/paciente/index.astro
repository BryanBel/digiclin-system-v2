---
import PortalLayout from '@/layouts/PortalLayout.astro';
import UnderConstruction from '@/components/UnderConstruction.astro';

const me = Astro.locals.me!;
---

<PortalLayout portal="paciente" title={`Hola, ${me.user.name}`}>
  <UnderConstruction
    phase={3}
    what="Tus datos de paciente, tu historia clínica, tus récipes y tus exámenes. La solicitud de citas llega en la fase 5."
  />
</PortalLayout>
