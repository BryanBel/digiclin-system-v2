---
import PortalLayout from '@/layouts/PortalLayout.astro';
import { buttonVariants } from '@/components/ui/button';
import { serverApi } from '@/lib/api.server';

const me = Astro.locals.me!;
const { data: pending = [] } = await serverApi(Astro.request).GET('/api/clinic/practitioners', {
  params: { query: { status: 'pending' } },
});
---

<PortalLayout portal="admin" title={me.clinic?.name ?? 'Administración'}>
  <ul class="grid max-w-3xl gap-4 md:grid-cols-2">
    <li class="rounded-lg border p-5">
      <h2 class="font-heading text-lg font-semibold">Solicitudes de médicos</h2>
      <p class="mt-1 text-3xl font-semibold">{pending.length}</p>
      <p class="text-sm text-muted-foreground">pendientes de revisión</p>
      <a href="/admin/medicos" class:list={[buttonVariants({ variant: 'outline' }), 'mt-4']}
        >Revisar</a
      >
    </li>
    <li class="rounded-lg border p-5">
      <h2 class="font-heading text-lg font-semibold">Equipo directivo</h2>
      <p class="mt-1 text-sm text-muted-foreground">
        {me.clinic?.roles.includes('owner') ? 'Invita a tus socios.' : 'Socios de la clínica.'}
      </p>
      <a href="/admin/socios" class:list={[buttonVariants({ variant: 'outline' }), 'mt-4']}
        >Ver socios</a
      >
    </li>
  </ul>
</PortalLayout>
